---
import SectionTitle from './SectionTitle';

const services = [
  {
    title: 'Desarrollo WordPress avanzado',
    description:
      'Temas y plugins a medida, automatizaciones, integraciones con APIs y optimización para sitios de alto rendimiento.'
  },
  {
    title: 'Aplicaciones con React & Node.js',
    description: 'Desarrollo full-stack con arquitecturas escalables, UI reactivas y despliegues continuos.'
  },
  {
    title: 'Optimización de rendimiento & SEO',
    description:
      'Auditorías técnicas, Core Web Vitals, caching inteligente, analítica y estrategias SEO enfocadas a resultados.'
  },
  {
    title: 'DevOps & Automatización',
    description: 'Docker, Apache/Nginx, Virtualmin/Plesk, pipelines CI/CD, Cloudflare y monitoreo proactivo.'
  }
];
---
<section id="services" class="section-container section-padding">
  <SectionTitle
    client:load
    eyebrow="Servicios"
    title="Soluciones integrales para tu presencia digital"
    description="Acompaño a equipos y marcas en todas las fases del ciclo de vida de un producto digital."
    align="center"
  />
  <div class="section-grid">
    {services.map((service) => (
      <article class="glass-card flex flex-col gap-4 p-6">
        <h3 class="text-xl font-semibold text-white">{service.title}</h3>
        <p class="text-sm leading-relaxed text-white/70">{service.description}</p>
      </article>
    ))}
  </div>
</section>
