---
import SectionTitle from './SectionTitle';

const testimonials = [
  {
    quote:
      'Marc se integra como parte del equipo y aporta soluciones antes de que los problemas aparezcan. Nuestro e-commerce nunca había cargado tan rápido.',
    name: 'Laura Hernández',
    role: 'COO, Nova Commerce'
  },
  {
    quote:
      'Su enfoque full-stack nos permitió lanzar en tiempo récord y con total confianza en la infraestructura. Es resolutivo y meticuloso en cada entrega.',
    name: 'Carlos Mena',
    role: 'Director Técnico, BlueLabs'
  },
  {
    quote:
      'Gestionó la migración a WordPress headless y optimizó SEO y Core Web Vitals sin interrupciones. La colaboración fue impecable.',
    name: 'Inés Romero',
    role: 'Marketing Manager, Brava Studio'
  }
];
---
<section id="testimonials" class="section-container section-padding">
  <SectionTitle
    client:load
    eyebrow="Testimonios"
    title="Clientes que confían en mi trabajo"
    description="Comentarios reales de colaboraciones recientes en proyectos web, apps y DevOps."
    align="center"
  />
  <div class="section-grid">
    {testimonials.map((testimonial) => (
      <article class="glass-card flex h-full flex-col gap-6 p-8">
        <p class="text-lg italic text-white/80">“{testimonial.quote}”</p>
        <div class="text-sm text-white/60">
          <p class="font-semibold text-white">{testimonial.name}</p>
          <p>{testimonial.role}</p>
        </div>
      </article>
    ))}
  </div>
</section>
